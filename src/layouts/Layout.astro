---
import Bunting from '@components/Bunting.astro';
import Footer from '@components/Footer.astro';
import Header from '@components/Header.astro';
import { resolveImage } from '@utils/images';

interface Props {
  title: string;
  description?: string;
  image?: string; // path under src/assets/images, as stored in frontmatter
}

const {
  title,
  description = 'The Parent, Teacher and Friends Association of Cotham Gardens Primary School in Bristol — fundraising and fun events for our school community.',
  image
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const imageMeta = await resolveImage(image);
const socialImageURL = imageMeta
  ? new URL(imageMeta.src, Astro.site)
  : undefined;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={description} />
    <meta name="viewport" content="width=device-width" />
    <link rel="canonical" href={canonicalURL} />

    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {socialImageURL && <meta property="og:image" content={socialImageURL} />}
    <meta
      name="twitter:card"
      content={socialImageURL ? 'summary_large_image' : 'summary'}
    />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    {socialImageURL && <meta name="twitter:image" content={socialImageURL} />}
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/icon.svg" type="image/svg+xml" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Fredoka:wght@500;600;700&family=Nunito:wght@400;600;700;800&display=swap"
      rel="stylesheet"
    />

    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
  </head>
  <body class="flex min-h-screen flex-col bg-amber-50 font-sans text-slate-700">
    <Bunting />
    <Header />
    <main class="container mx-auto flex-grow">
      <slot />
    </main>
    <Footer />
    <style is:global>
      h1,
      h2,
      h3 {
        @apply mb-4 font-display font-bold;
      }
      h1 {
        @apply text-3xl text-brand-teal-dark md:text-4xl;
      }
      h2 {
        @apply text-2xl text-brand-green-dark;
      }
      h3 {
        @apply text-xl text-brand-purple-dark;
      }
      p {
        @apply mb-4 leading-relaxed;
      }
      main a,
      footer a {
        @apply font-bold text-brand-coral-dark underline decoration-2 underline-offset-2 transition-colors hover:text-brand-teal-dark;
      }
      /* Playful bullet lists in the markdown content */
      .prose ul {
        @apply my-4 space-y-2 pl-0;
      }
      .prose ul li {
        @apply relative list-none pl-7;
      }
      .prose ul li::before {
        content: '';
        @apply absolute left-0 top-2 h-3 w-3 rounded-full bg-brand-green;
      }
      .prose strong {
        @apply font-extrabold text-slate-800;
      }
    </style>
  </body>
</html>
