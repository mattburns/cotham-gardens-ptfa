---
import EventCard from '@components/EventCard.astro';
import Layout from '@layouts/Layout.astro';
import { getCollection } from 'astro:content';
const events = (await getCollection('events')).sort(
  (a, b) => a.data.eventDate.valueOf() - b.data.eventDate.valueOf()
);

// Subscribable feed of all events (see src/pages/events.ics.ts)
const feedUrl = new URL('/events.ics', Astro.site!);
const webcalUrl = feedUrl.toString().replace(/^https?:/, 'webcal:');
const googleSubscribeUrl = `https://calendar.google.com/calendar/r?cid=${encodeURIComponent(webcalUrl)}`;
---

<Layout title="Events - Cotham Gardens PTFA">
  <div class="prose lg:prose-xl px-4 py-8">
    <h1>Upcoming Events</h1>

    <div
      class="not-prose mb-6 flex flex-col gap-3 rounded-3xl border-4 border-brand-yellow bg-white p-4 shadow-md sm:flex-row sm:items-center"
    >
      <div class="font-display text-lg font-bold text-slate-800 sm:mr-auto">
        📅 Never miss an event — subscribe to our calendar
      </div>
      <div class="flex flex-col gap-2 sm:shrink-0 sm:flex-row sm:items-center">
        <a
          href={googleSubscribeUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="rounded-full bg-brand-green px-4 py-2 text-center text-sm font-bold !text-slate-900 no-underline transition hover:scale-105 hover:shadow"
        >
          Google Calendar
        </a>
        <a
          href={webcalUrl}
          class="rounded-full bg-brand-teal px-4 py-2 text-center text-sm font-bold !text-slate-900 no-underline transition hover:scale-105 hover:shadow"
        >
          Apple / Outlook
        </a>
        <a
          href="/events.ics"
          class="text-center text-sm font-normal !text-slate-500 hover:!text-brand-teal-dark"
        >
          .ics link
        </a>
      </div>
    </div>
    <div
      id="upcoming-events"
      class="grid grid-cols-1 gap-4 md:grid-cols-2 lg:grid-cols-3"
    >
      {
        events.map((event, i) => (
          <div
            class="event-item"
            data-event-date={event.data.eventDate.toISOString()}
          >
            <EventCard event={event} index={i} />
          </div>
        ))
      }
    </div>

    <h1 class="mt-8">Past Events</h1>
    <div
      id="past-events"
      class="grid grid-cols-1 gap-4 opacity-50 md:grid-cols-2 lg:grid-cols-3"
    >
      {
        events.map((event, i) => (
          <div
            class="event-item"
            data-event-date={event.data.eventDate.toISOString()}
          >
            <EventCard event={event} index={i} />
          </div>
        ))
      }
    </div>
  </div>

  <script>
    function filterEvents() {
      const now = new Date();
      const upcomingContainer = document.getElementById('upcoming-events');
      const pastContainer = document.getElementById('past-events');

      if (!upcomingContainer || !pastContainer) return;

      const upcomingEvents = upcomingContainer.querySelectorAll('.event-item');
      const pastEvents = pastContainer.querySelectorAll('.event-item');

      // Filter upcoming events
      upcomingEvents.forEach((eventEl) => {
        const eventDate = new Date(
          eventEl.getAttribute('data-event-date') || ''
        );
        if (eventDate >= now) {
          eventEl.style.display = '';
        } else {
          eventEl.style.display = 'none';
        }
      });

      // Filter past events (in reverse chronological order)
      const pastEventsArray = Array.from(pastEvents);
      pastEventsArray.sort((a, b) => {
        const dateA = new Date(a.getAttribute('data-event-date') || '');
        const dateB = new Date(b.getAttribute('data-event-date') || '');
        return dateB.getTime() - dateA.getTime();
      });

      pastEventsArray.forEach((eventEl) => {
        const eventDate = new Date(
          eventEl.getAttribute('data-event-date') || ''
        );
        if (eventDate < now) {
          eventEl.style.display = '';
          pastContainer.appendChild(eventEl);
        } else {
          eventEl.style.display = 'none';
        }
      });
    }

    // Run on page load
    filterEvents();
  </script>
</Layout>
