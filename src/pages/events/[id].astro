---
import Layout from '@layouts/Layout.astro';

import AddToCalendar from '@components/AddToCalendar.astro';
import HeroHeader from '@components/HeroHeader.astro';
import { markdownToText } from '@utils/text';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const events = await getCollection('events');
  return events.map((event) => ({
    params: { id: event.id },
    props: { event }
  }));
}

const { event } = Astro.props;
const { Content } = await render(event);

// Plain-text excerpt of the event body for search results and link previews
const description = markdownToText(event.body)
  .replace(/\s+/g, ' ')
  .replace(/^(.{0,160})(\s.*)?$/s, '$1');
---

<Layout
  title={event.data.title + ' - Cotham Gardens PTFA'}
  description={description}
  image={event.data.image}
>
  <HeroHeader
    title={event.data.title}
    image={event.data.image}
    date={event.data.eventDate}
  />

  <div class="prose lg:prose-xl px-4">
    <a href="/events" class="mb-4 block">&larr; All Events</a>
    <AddToCalendar event={event} />
    <Content />
  </div>
</Layout>
